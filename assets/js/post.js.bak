const article = document.getElementById("article");

async function loadArticle() {
    const params = new URLSearchParams(location.search);
    const slug = params.get("slug");

    if (!slug || !/^[a-zA-Z0-9_-]+$/.test(slug)) {
        article.innerHTML = '<div class="empty">Publication not found.</div>';
        return;
    }

    try {
        const response = await fetch(`posts/${slug}.md`);

        if (!response.ok) throw new Error("Not found");

        const markdown = await response.text();

        const match = markdown.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);

        let metadata = {};
        let content = markdown;

        if (match) {
            match[1].split(/\r?\n/).forEach(line => {
                const separator = line.indexOf(":");
                if (separator < 0) return;

                const key = line.slice(0, separator).trim();
                const value = line.slice(separator + 1).trim();

                metadata[key] = value.replace(/^["']|["']$/g, "");
            });

            content = markdown.slice(match[0].length);
        }

        document.title = `${metadata.title || "Publication"} | ITSFOUR_ HUB`;

        article.innerHTML = `
            <span class="section-index">PUBLICATION / ${metadata.category || "GENERAL"}</span>

            <h1>${escapeHTML(metadata.title || "Untitled")}</h1>

            <div class="article-meta">
                ${escapeHTML(metadata.date || "")}
                · ITSFOUR_
            </div>

            <div class="article-actions">
                <button id="share">↗ Share</button>
                <button id="copy">▣ Copy URL</button>
            </div>

            <div class="markdown" id="markdown-content"></div>
        `;

        const markdownContent = document.getElementById("markdown-content");

        if (window.marked) {
            markdownContent.innerHTML = marked.parse(content);
        } else {
            markdownContent.textContent = content;
        }

        document.getElementById("share").onclick = async () => {
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: metadata.title || "ITSFOUR_ HUB",
                        url: location.href
                    });
                } catch (error) {}
            } else {
                copyURL();
            }
        };

        document.getElementById("copy").onclick = copyURL;

    } catch (error) {
        article.innerHTML = '<div class="empty">Publication not found.</div>';
    }
}

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

async function copyURL() {
    try {
        await navigator.clipboard.writeText(location.href);
        alert("URL copied!");
    } catch (error) {
        prompt("Copy this URL:", location.href);
    }
}

loadArticle();